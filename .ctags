--links=no
--excmd=number

--langdef=customjs
--langmap=customjs:.js.cjs.mjs.ts.vue

--regex-customjs=/^[ \t]*(export[ \t]+)?(default[ \t]+)?(abstract[ \t]+)?class[ \t]+([a-zA-Z0-9_]+)/\4/c,classes/
--regex-customjs=/^[ \t]*(export[ \t]+)?(namespace|module)[ \t]+([a-zA-Z0-9_]+)/\3/n,modules/
--regex-customjs=/^[ \t]*(export[ \t]+)?type[ \t]+([a-zA-Z0-9_]+)/\2/t,types/
--regex-customjs=/^[ \t]*(export[ \t]+)?(var|const|let)[ \t]+([a-zA-Z0-9_]+)/\3/v,variables/
--regex-customjs=/^[ \t]*(export[ \t]+)?(default[ \t]+)?(async[ \t]+)?function[* \t]+([a-zA-Z0-9_]+)/\4/f,functions/
--regex-customjs=/^[ \t]*(export[ \t]+)?interface[ \t]+([a-zA-Z0-9_]+)/\2/i,interfaces/
--regex-customjs=/^[ \t]*(export[ \t]+)?(const[ \t]+)?enum[ \t]+([a-zA-Z0-9_]+)/\3/e,enums/

--regex-customjs=/^[ \t]*(public[ \t]+|private[ \t]+|protected[ \t]+)?constructor\(/constructor/m,methods/
--regex-customjs=/^[ \t]*(static[ \t]+)?(get|set)[ \t]+([a-zA-Z][a-zA-Z0-9_]*)[ \t]*\(/\3/m,methods/
--regex-customjs=/^[ \t]*(public|private|protected)[ \t]+(static[ \t]+)?(readonly[ \t]+)?(async[ \t]+)?(abstract[ \t]+)?[*]?[ \t]*(#?[a-zA-Z][a-zA-Z0-9_]*)(<.*>)?\(/\6/m,methods/
--regex-customjs=/^[ \t]*static[ \t]+(async[ \t]+)?[*]?[ \t]*(#?[a-zA-Z][a-zA-Z0-9_]*)(<.*>)?\(/\2/m,methods/
--regex-customjs=/^[ \t]*abstract[ \t]+(#?[a-zA-Z][a-zA-Z0-9_]*)(<.*>)?\(/\1/m,methods/
--regex-customjs=/^[ \t]*override[ \t]+(async[ \t]+)?[*]?[ \t]*(#?[a-zA-Z][a-zA-Z0-9_]*)(<.*>)?\(/\2/m,methods/
--regex-customjs=/^[ \t]*async[ \t]+[*]?[ \t]*(#?[a-zA-Z][a-zA-Z0-9_]*)(<.*>)?\(/\1/m,methods/
--regex-customjs=/^[ \t]*[*]?[ \t]*(#?[a-zA-Z][a-zA-Z0-9_]*)(<.*>)?\(.*\)[ \t]*[:{]/\1/m,methods/

--regex-customjs=/^[ \t]*(public[ \t]+|private[ \t]+|protected[ \t]+)?(static[ \t]+)?(readonly[ \t]+)?(#[a-zA-Z0-9_]+)[ \t]*[!?]?[ \t]*[:=]/\4/p,properties/
--regex-customjs=/^[ \t]*(public|private|protected)[ \t]+(static[ \t]+)?(readonly[ \t]+)?([a-zA-Z][a-zA-Z0-9_]*)[ \t]*[!?]?[ \t]*[:=]/\4/p,properties/
--regex-customjs=/^[ \t]*static[ \t]+(readonly[ \t]+)?([a-zA-Z][a-zA-Z0-9_]*)[ \t]*[!?]?[ \t]*[:=]/\2/p,properties/
--regex-customjs=/^[ \t]*readonly[ \t]+([a-zA-Z][a-zA-Z0-9_]*)[ \t]*[!?]?[ \t]*[:=]/\1/p,properties/
